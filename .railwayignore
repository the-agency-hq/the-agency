# `railway up` uploads the working directory, and `latte deploy` runs it with --no-gitignore
# because the bundle lives under the gitignored build/ directory. This file (gitignore syntax)
# keeps that upload to exactly what the Dockerfile build needs: the bundle and the Dockerfile.
# Service configuration lives in .railway/railway.ts, which `railway config` reads directly —
# it is never part of the upload.
/*
!/build
/build/*
!/build/bundle
!/Dockerfile
